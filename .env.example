# Получите у @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# URL вашего деплоя + путь до webhook
WEBHOOK_URL=https://your-app.vercel.app/api/webhook

# Случайные секреты (можно сгенерировать `openssl rand -hex 32`)
SETUP_SECRET=replace-with-random-string
CRON_SECRET=replace-with-another-random-string

# Upstash Redis (создать на upstash.com)
UPSTASH_REDIS_REST_URL=https://your-region-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXXXXxxxXXXXxxx

# Опционально: ваш Telegram chat_id, чтобы пользоваться /stats
ADMIN_CHAT_ID=
